<%= form_with model: program, class: "stack-form" do |form| %>
  <% if program.errors.any? %>
    <div class="flash flash-alert">
      <%= program.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name, "Program name" %>
    <%= form.text_field :name, required: true, autofocus: true, placeholder: "Full Body ABC" %>
  </div>

  <div class="field">
    <label>
      <%= form.check_box :active %>
      <span>Make this the active program</span>
    </label>
    <p class="field-hint">The active program appears first when choosing workout types.</p>
  </div>

  <div class="button-row">
    <%= form.submit class: "button" %>
    <%= link_to "Cancel", programs_path, class: "button button-ghost" %>
  </div>
<% end %>
